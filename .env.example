# OpenAI API Key (required for OpenAI embeddings and LLM)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (optional, for Claude models)
ANTHROPIC_API_KEY=

# HuggingFace Token (optional, for gated models)
HUGGINGFACE_TOKEN=

# RAGAS Benchmark Settings (uses LiteLLM — supports 100+ providers)
RAGAS_EVALUATOR_MODEL=openai/gpt-4.1-mini
RAGAS_MAX_WORKERS=16
RAGAS_TIMEOUT=120
RAGAS_MAX_RETRIES=2
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_CONFIG_PARALLEL=6

# OpenRouter API Key (for higher rate limits via LiteLLM)
OPENROUTER_API_KEY=
